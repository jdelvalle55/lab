# Copy to .env on vmwindows (never commit .env). Loaded by run_server.ps1.
ORACLE_DSN=dbhost.example:1521/JDV920      # JDV920 service name
ORACLE_USER=JDEAGENT_RO
# Thick mode (required when the DB enforces Native Network Encryption, as JDEPDB does)
ORACLE_CLIENT_LIB=C:\app\client\Administrator\product\19.0.0\client_1\bin
ORACLE_PASSWORD=change-me
# JDE user whose scope applies (test only; the E1 Page front end will pass the real user later)
JDE_AGENT_USER=JDE
MCP_HOST=127.0.0.1                          # 0.0.0.0 only behind a Windows firewall rule
MCP_PORT=8082                               # 8081 stays the PO approval agent
SERVICE_LEVEL_Z=1.65                        # ~95% cycle service level
REVIEW_PERIOD_DAYS=30                       # reorder qty covers this many days of usage
USAGE_WEEKS=13
DEFAULT_LEAD_TIME_DAYS=14                   # used only when IBLTLV = 0; results flagged lead_time_assumed. 0 = off
PLANNED_STOCKING_TYPES=P,M
MIN_LT_RECEIPTS=3                           # receipts needed before actual lead time is trusted
LT_DRIFT_PCT=25                             # flag when actual vs planned lead time differs by this %
# --- Alerts (python -m jde_agent.alerts) ---
ALERT_MSG_TYPES=B,C,D,E                     # MRP message types that alert; add O to include plain orders
ALERT_MIN_DAYS_LATE=0
ALERT_TO=                                   # comma-separated; empty = dry run to outbox
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=jde-agent@example.com
SMTP_STARTTLS=false
# Teams: Workflows "Post to a channel when a webhook request is received" URL. Secret: keep in .env only.
# Used when the task runs with -Send; takes precedence over SMTP.
TEAMS_WEBHOOK_URL=
TEAMS_MAX_ROWS=40
